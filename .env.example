# UniMarket v2 — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and safe for secrets.
# On Render, set these in: Dashboard → your service → Environment tab.

# ── Supabase (required) ───────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── PayFast Payment Configuration (optional) ─────────────────────────────────
# Get these from your PayFast merchant account at https://www.payfast.co.za
# Leave blank to fall back to cash-on-meetup (safe for development)
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=

# Set to "false" only when going live with real transactions
VITE_PAYFAST_SANDBOX=true

# The public URL of your deployed payfast-notify Supabase Edge Function.
# Format: https://<project-ref>.supabase.co/functions/v1/payfast-notify
# Leave blank to disable PayFast
VITE_PAYFAST_NOTIFY_URL=

